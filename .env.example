# Prisma Postgres (as mesmas 3 variáveis criadas no projeto vinculado)
# Copie este arquivo para .env e preencha com os valores reais.
# Não commite o arquivo .env.

# Runtime / Prisma Client (pooled ou prisma+postgres://)
DATABASE_URL=""

# Conexão PostgreSQL direta (migrate, introspect, Prisma Studio)
POSTGRES_URL=""

# URL nativa do Prisma Postgres / Accelerate (prisma+postgres://)
PRISMA_DATABASE_URL=""
