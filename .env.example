# Prisma Postgres
# Copie este arquivo para .env e preencha com os valores reais.
# Não commite o arquivo .env.
# Nenhum secret deve usar prefixo NEXT_PUBLIC_.

# Runtime da aplicação (Prisma Client). Se existir um pooler serverless, use-o aqui.
DATABASE_URL=""

# Conexão PostgreSQL direta (migrate, introspect, Prisma Studio), se distinta da runtime.
POSTGRES_URL=""

# URL nativa do Prisma Postgres / Accelerate, se fornecida pelo ambiente.
PRISMA_DATABASE_URL=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail transacional (Resend). Sem domínio de envio configurado, deixe vazio.
RESEND_API_KEY=""
EMAIL_FROM=""

# Cadastro controlado do piloto. Allowlist é só de registro, não de sessão.
# Em Preview/Production, se o modo piloto estiver ativo e a lista estiver vazia, novos cadastros são bloqueados.
PILOT_REGISTRATION_ENABLED="true"
PILOT_ALLOWED_EMAILS=""
