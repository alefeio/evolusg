# Prisma Postgres
# Copie este arquivo para .env e preencha com os valores reais.
# Não commite o arquivo .env.
# Nenhum secret deve usar prefixo NEXT_PUBLIC_.

# Runtime da aplicação (Prisma Client / Better Auth).
# Em Vercel/serverless, prefira uma URL pooled quando ela existir.
DATABASE_URL=""

# Conexão direta para migrations, introspect e Prisma Studio.
# Se vazia, o CLI usa POSTGRES_URL e, por último, DATABASE_URL.
DIRECT_URL=""

# Conexão PostgreSQL direta (legado do ambiente atual). Usada nas migrations se DIRECT_URL estiver vazia.
POSTGRES_URL=""

# URL nativa do Prisma Postgres / Accelerate (prisma+postgres://), se fornecida pelo ambiente.
PRISMA_DATABASE_URL=""

# Rótulo obrigatório antes de prisma migrate deploy ou testes de integração.
# Valores aceitos: development | preview | test | production
# Sem este rótulo (ou VERCEL_ENV=preview/development), migrate/integração permanecem BLOCKED.
DATABASE_ENV=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail transacional (Resend). Sem domínio de envio configurado, deixe vazio.
RESEND_API_KEY=""
EMAIL_FROM=""

# Captura local de e-mail. Ignorada em Production/Vercel. Não é um bypass público.
# AUTH_EMAIL_CAPTURE_FILE=".local-email-capture.json"

# Cadastro controlado do piloto. Allowlist é só de registro, não de sessão.
# Em Preview/Production, se o modo piloto estiver ativo e a lista estiver vazia, novos cadastros são bloqueados.
PILOT_REGISTRATION_ENABLED="true"
PILOT_ALLOWED_EMAILS=""
